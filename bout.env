# Setup environment for running BOUT++ programs
#
# Enable by doing `source bout.env` in your terminal, or source (using the full path) in your .bashrc

module purge


###################################
# YPI WORKSTATIONS
###################################

#module load tools/git/2.32.0-GCCcore-10.3.0-nodocs
module load mpi/OpenMPI/4.1.1-GCC-10.3.0
module load devel/CMake/3.20.1-GCCcore-10.3.0  # Loading this makes GDB not work
module load numlib/OpenBLAS/0.3.15-GCC-10.3.0
module load lib/FlexiBLAS/3.0.4-GCC-10.3.0
#module load devel/ncurses/6.2-GCCcore-10.3.0
module load data/netCDF/4.8.0-gompi-2021a
#module load lang/Python/3.9.5-GCCcore-10.3.0
#module load lang/SciPy-bundle/2021.05-foss-2021a

